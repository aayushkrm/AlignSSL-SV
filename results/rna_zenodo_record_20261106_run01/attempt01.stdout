{"created": "2026-05-14T22:03:45.073708+00:00", "modified": "2026-05-14T22:03:49.219589+00:00", "id": 18763244, "conceptrecid": "12555793", "doi": "10.5281/zenodo.18763244", "conceptdoi": "10.5281/zenodo.12555793", "doi_url": "https://doi.org/10.5281/zenodo.18763244", "metadata": {"title": "Direct long-read RNA sequencing uncovers functional variation affecting transcript production and RNA modifications.", "doi": "10.5281/zenodo.18763244", "publication_date": "2026-05-14", "description": "<p class=\"LO-normal\">The production of multiple transcripts per gene is a process regulated by inherited genetic variants and epitranscriptomic modifications and plays a prominent role in modulating complex traits and diseases. To simultaneously characterize the effect of genetic variants on transcript abundance and N6-methyladenosine (m\u2076A) modifications, we produced long-read native poly(A) RNA-seq data for 60 genetically different lymphoblastoid cell lines (LCLs) from the 1000 Genomes/Geuvadis project. We identified a high diversity of both annotated (40.2%) and unannotated (59.8%) transcripts, with only a small proportion expressed across individuals (35% and 18.4%, respectively). In a genome-wide genetic analysis on transcripts, we identified 87 trQTLs (transcript quantitative trait loci), of which 55 were not detected as eQTLs using a larger published short-read RNAseq dataset (317 samples). A population-wide characterization of m\u2076A methylation DRACH motifs (canonical m\u2076A consensus sequence) identified an average of 4.04 m\u2076A modifications on 4,325 genes. Genetic association analysis of highly variable modifications from 1,272 genes identified m\u2076A modification quantitative trait loci (m\u2076A-QTLs) for 5 transcripts. Even with a limited number of genetic associations, colocalization analysis of trQTLs and m\u2076A-QTLs identified 8 candidate transcripts mediating GWAS traits, with approximately 75% of the colocalized trQTLs implicating novel risk transcripts, and an enrichment of GWAS lead variants involved in trQTLs. Overall, the simultaneous characterization of transcripts and post-transcriptional modifications identified genetic effects on transcription often missed when using other sequencing technologies.</p>\n<p>Preprint link:&nbsp;https://www.researchsquare.com/article/rs-4613444/v2</p>", "access_right": "open", "creators": [{"name": "R\u00e9al, Aline", "affiliation": "New York Genome Center", "orcid": "0000-0002-9437-4411"}, {"name": "Vi\u00f1uela, Ana", "affiliation": "University of Dundee", "orcid": "0000-0003-3771-8537"}], "contributors": [{"name": "Brown, Andrew", "affiliation": "University of Dundee", "type": "ProjectMember"}, {"name": "Ramisch, Anna", "affiliation": "University of Geneva", "type": "ProjectMember"}, {"name": "Dermitzakis, Emmanouil", "affiliation": "University of Geneva", "type": "ProjectMember"}, {"name": "Lykoskoufis, Nikolaos", "affiliation": "University of Geneva", "type": "ProjectMember"}, {"name": "Borel, Christelle", "affiliation": "University of Geneva", "type": "ProjectMember"}, {"name": "Puga Yung, Gisella", "affiliation": "University of Geneva", "type": "ProjectMember"}, {"name": "Seebach, Joerg", "affiliation": "University of Geneva", "type": "ProjectMember"}], "related_identifiers": [{"identifier": "PRJEB76585", "relation": "describes", "resource_type": "dataset", "scheme": "other"}], "dates": [{"type": "updated"}], "version": "V2", "references": ["https://www.researchsquare.com/article/rs-4613444/v2"], "custom": {"code:codeRepository": "https://github.com/aline2593/DRS-LCLs-qtl-analysis"}, "resource_type": {"title": "Journal article", "type": "publication", "subtype": "article"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "SBF007\\100033", "internal_id": "00c489v88::SBF007\\100033", "funder": {"name": "Academy of Medical Sciences"}, "title": "Investigating age-related splicing and its links to type 2 diabetes.", "url": "https://europepmc.org/grantfinder/grantdetails?query=gid%3A%22SBF007%5C100033%22"}], "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "12555793"}}]}}, "title": "Direct long-read RNA sequencing uncovers functional variation affecting transcript production and RNA modifications.", "links": {"self": "https://zenodo.org/api/records/18763244", "self_html": "https://zenodo.org/records/18763244", "preview_html": "https://zenodo.org/records/18763244?preview=1", "doi": "https://doi.org/10.5281/zenodo.18763244", "self_doi": "https://doi.org/10.5281/zenodo.18763244", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.18763244", "reserve_doi": "https://zenodo.org/api/records/18763244/draft/pids/doi", "parent": "https://zenodo.org/api/records/12555793", "parent_html": "https://zenodo.org/records/12555793", "parent_doi": "https://doi.org/10.5281/zenodo.12555793", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.12555793", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:18763244/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:18763244/sequence/default", "files": "https://zenodo.org/api/records/18763244/files", "media_files": "https://zenodo.org/api/records/18763244/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:18763244:Real_preprint_2026.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:18763244:Real_preprint_2026.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:18763244:Real_preprint_2026.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:18763244:Real_preprint_2026.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:18763244:Real_preprint_2026.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:18763244:Real_preprint_2026.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/18763244/versions/latest", "latest_html": "https://zenodo.org/records/18763244